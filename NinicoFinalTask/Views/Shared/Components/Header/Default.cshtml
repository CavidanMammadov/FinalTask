@using NinicoFinalTask.ViewModel.Basket
@model List<GetBasketItemVM>

<!-- header-cart-start -->
<div class="tpcartinfo tp-cart-info-area p-relative">
    <button class="tpcart__close"><i class="fal fa-times"></i></button>
    <div class="tpcart">
        <h4 class="tpcart__title">Your Cart</h4>
        <div class="tpcart__product">
            <div class="tpcart__product-list">
                <ul>
                    @foreach (var item in Model)
                    {
                        <li>
                            <div class="tpcart__item">
                                <div class="tpcart__img">
                                    <img src="~/imgs/products/@item.ImageUrl" alt="@item.Name">
                                    <div class="tpcart__del">
                                        <a asp-action="Delete" asp-controller="Basket" asp-route-id="@item.Id"><i class="far fa-times-circle"></i></a>
                                    </div>
                                </div>
                                <div class="tpcart__content">
                                    <span class="tpcart__content-title">
                                        <a href="shop-details.html">@item.Name</a>
                                    </span>
                                    <div class="tpcart__cart-price">
                                        <span class="quantity">@item.Count x</span>
                                        @if (item.Discount > 0)
                                        {
                                            <span class="new-price">$@((100 - item.Discount) * item.SellPrice / 100)</span>
                                            <del class="old-price">$@item.SellPrice</del>
                                        }
                                        else
                                        {
                                            <span class="new-price">$@item.SellPrice</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="tpcart__checkout">
                <div class="tpcart__total-price d-flex justify-content-between align-items-center">
                    <span>Subtotal:</span>
                    <span class="heilight-price">
                        $@(Model.Sum(x => (100 - x.Discount) * x.SellPrice / 100 * x.Count))
                    </span>
                </div>
                <div class="tpcart__checkout-btn">
                    <a class="tpcart-btn mb-10" asp-controller="Basket" asp-action="Card">View Cart</a>
                    <a class="tpcheck-btn" href="checkout.html">Checkout</a>
                </div>
            </div>
        </div>
        <div class="tpcart__free-shipping text-center">
            <span>Free shipping for orders <b>under 10km</b></span>
        </div>
    </div>
</div>
<div class="cartbody-overlay"></div>
<!-- header-cart-end -->
