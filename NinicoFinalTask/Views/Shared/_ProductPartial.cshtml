@using NinicoFinalTask.ViewModel.Product
@model List<ProductItemVM>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="tpproduct tpproductitem mb-15 p-relative">
                    <div class="tpproduct__thumb">
                        <a href="/Product/Details/@product.Id">
                            <img src="/imgs/products/@product.ImageUrl" alt="@product.Name">
                        </a>
                    </div>
                    <div class="tpproduct__content-area">
                        <h3 class="tpproduct__title mb-5">
                            <a href="/Product/Details/@product.Id">@product.Name</a>
                        </h3>
                        <div class="tpproduct__priceinfo p-relative">
                            <div class="tpproduct__ammount">
                                @if (product.Discount > 0)
                                {
                                    <span style="text-decoration: line-through; color: red;">$@product.Price</span>
                                    <span>$@(product.Price - product.Discount)</span>
                                }
                                else
                                {
                                    <span>$@product.Price</span>
                                }
                            </div>
                        </div>
                        <a asp-action="AddBasket" asp-controller="Basket" asp-route-id="@product.Id" class="add-to-cart"><i class="fal fa-shopping-cart"></i>Add To Cart</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">No products found.</div>
}
