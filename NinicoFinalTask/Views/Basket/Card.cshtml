@using NinicoFinalTask.ViewModel.Basket
@model List<GetBasketItemVM>

@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <section class="cart-area pt-80 pb-80">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-content table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Image</th>
                                        <th>Name</th>
                                        <th>Unit Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <img src="~/imgs/products/@item.ImageUrl" alt="@item.Name" width="50">
                                            </td>
                                            <td>@item.Name</td>
                                            <td>$@item.SellPrice</td>
                                            <td>@item.Count</td>
                                            <td>
                                                $@((item.SellPrice * item.Count) * (1 - (item.Discount / 100.0M)))
                                            </td>
                                            <td>
                                                <a asp-action="Delete" asp-controller="Basket" asp-route-id="@item.Id" class="text-danger">
                                                    <i class="fa fa-times"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <div class="cart-page-total">
                                    <h2>Cart Totals</h2>
                                    <ul>
                                        <li>
                                            Subtotal
                                            <span>
                                                $@(Model.Sum(x => (x.SellPrice * x.Count) * (1 - (x.Discount / 100.0M))))
                                            </span>
                                        </li>
                                        <li>
                                            Total
                                            <span>
                                                $@(Model.Sum(x => (x.SellPrice * x.Count) * (1 - (x.Discount / 100.0M))))
                                            </span>
                                        </li>
                                    </ul>
                                    <a href="checkout.html" class="tp-btn tp-color-btn banner-animation">
                                        Proceed to Checkout
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <h2>Your cart is empty</h2>
                            <a href="/" class="tp-btn tp-color-btn banner-animation">Return to Shop</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</main>
