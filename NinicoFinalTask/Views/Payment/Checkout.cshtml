@using NinicoFinalTask.ViewModel.Basket

@{
    Layout = null;
}

@model CheckoutViewModel

@{
    ViewData["Title"] = "Ödəniş Səhifəsi";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg p-4">
                <h2 class="text-center">Ödəniş</h2>
                <hr>

                <p class="text-center">Səbətinizin ümumi məbləği: <strong>@Model.TotalAmount AZN</strong></p>

                <form action="/Payment/Process" method="post">
                    <input type="hidden" name="amount" value="@Model.TotalAmount" />

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-credit-card"></i> Ödənişi tamamla
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a href="/Basket" class="btn btn-outline-secondary">← Səbətə qayıt</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap & FontAwesome üçün -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
