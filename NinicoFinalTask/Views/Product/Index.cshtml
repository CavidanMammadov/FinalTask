<main>
    <!-- product-area-start -->
    <div class="product-area pt-70 pb-20">
        <div class="container">
            <div class="row">
                <!-- Sidebar -->
                <div class="col-lg-2 col-md-12">
                    <div class="tpsidebar product-sidebar__product-category">
                        <div class="product-sidebar">
                            <!-- Category Filter -->
                            <div class="product-sidebar__widget mb-30">
                                <div class="product-sidebar__info product-info-list">
                                    <h4 class="product-sidebar__title mb-25">Category</h4>
                                    <ul class="sidebar__list">
                                        @foreach (var item in Model.Categories)
                                        {
                                            <li>
                                                <input type="checkbox" class="category-filter" value="@item.Id"> @item.Name (@item.Count)
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                            <!-- Price Filter -->
                            <div class="product-sidebar__widget mb-30">
                                <div class="product-sidebar__info product-info-list">
                                    <h4 class="product-sidebar__title mb-30">Filter</h4>
                                    <div class="productsidebar__range">
                                        <input type="range" id="minPrice" min="10" max="500" value="10">
                                        <input type="range" id="maxPrice" min="10" max="500" value="500">
                                        <p>Price: <span id="priceRange">$10 - $500</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Products -->
                <div class="col-lg-10 col-md-12">
                    <div class="row row-cols-xxl-4 row-cols-xl-4 row-cols-lg-3 row-cols-md-3 row-cols-sm-2 row-cols-1 tpproduct">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col">
                                <div class="tpproduct tpproductitem mb-15 p-relative">
                                    <div class="tpproduct__thumb">
                                        <a href="/Product/Details/@product.Id">
                                            <img src="~/imgs/products/@product.ImageUrl" alt="@product.Name">
                                        </a>
                                    </div>
                                    <div class="tpproduct__content-area">
                                        <h3 class="tpproduct__title mb-5">
                                            <a href="/Product/Details/@product.Id">@product.Name</a>
                                        </h3>
                                        <div class="tpproduct__priceinfo p-relative">
                                            <div class="tpproduct__ammount">
                                                @if (product.Discount > 0)
                                                {
                                                    <span style="text-decoration: line-through; color: red;">$@product.Price</span>
                                                    <span>$@(product.Price - product.Discount)</span>
                                                }
                                                else
                                                {
                                                    <span>$@product.Price</span>
                                                }
                                            </div>
                                        </div>
                                        <a asp-action="card" asp-controller="Basket"><i class="fal fa-shopping-cart"></i>Add To Cart</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- product-area-end -->
</main>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".add-to-cart").click(function () {
                let productId = $(this).data("id");
                fetch(`/Basket/AddProduct?id=${productId}`)
                    .then(response => response.text())
                    .then(() => alert("Məhsul səbətə əlavə edildi"));
            });

            $("#minPrice, #maxPrice").on("input", function () {
                let minPrice = $("#minPrice").val();
                let maxPrice = $("#maxPrice").val();
                $("#priceRange").text(`$${minPrice} - $${maxPrice}`);
                getFilteredProducts();
            });

            function getFilteredProducts() {
                let minPrice = $("#minPrice").val();
                let maxPrice = $("#maxPrice").val();
                let catId = $(".category-filter:checked").map(function () { return this.value; }).get();

                fetch(`/Product/Filter?catId=${catId}&minPrice=${minPrice}&maxPrice=${maxPrice}`)
                    .then(response => response.text())
                    .then(data => $(".tpproduct").html(data));
            }
        });
    </script>
}
